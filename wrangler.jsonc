{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trap-mofumofu-me",
  "compatibility_date": "2026-08-09",

  // 静的アセットのみを配信する Worker（Cloudflare Workers Static Assets）。
  // SPA なので、存在しないパスは index.html にフォールバックさせる。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }

  // 独自ドメインを割り当てる場合は Cloudflare ダッシュボード、または以下を有効化:
  // "routes": [
  //   { "pattern": "trap.mofumofu.me", "custom_domain": true }
  // ]
}
